{
  "root": {
    "id": "root",
    "kind": "stack",
    "props": {
      "gap": 16
    },
    "children": [
      {
        "id": "banner",
        "kind": "badge",
        "props": {
          "text": "Python 提供者 · 模拟业务",
          "tone": "accent"
        },
        "children": []
      },
      {
        "id": "heading",
        "kind": "text",
        "props": {
          "text": "窗口只是身体，业务仍在程序中",
          "size": "title"
        },
        "children": []
      },
      {
        "id": "clock",
        "kind": "metric",
        "props": {
          "label": "专注倒计时",
          "value": {
            "$path": "/clock"
          },
          "caption": "权威计时来自 Python 提供者"
        },
        "children": []
      },
      {
        "id": "progress",
        "kind": "progress",
        "props": {
          "label": "后台任务（模拟）",
          "value": {
            "$path": "/progress"
          },
          "max": 100
        },
        "children": []
      },
      {
        "id": "buttons",
        "kind": "row",
        "props": {
          "gap": 8
        },
        "children": [
          {
            "id": "pause",
            "kind": "button",
            "props": {
              "label": {
                "$path": "/button"
              },
              "action": "toggle_pause",
              "tone": "accent"
            },
            "children": []
          },
          {
            "id": "rebuild",
            "kind": "button",
            "props": {
              "label": "替换组件区",
              "action": "rebuild",
              "context_action": "rebuild"
            },
            "children": []
          }
        ]
      },
      {
        "id": "note",
        "kind": "input",
        "props": {
          "label": "消息",
          "value": {
            "$path": "/note"
          },
          "placeholder": "输入并提交",
          "action": "note"
        },
        "children": []
      },
      {
        "id": "source",
        "kind": "text",
        "props": {
          "text": {
            "$path": "/source"
          },
          "tone": "muted"
        },
        "children": []
      }
    ]
  },
  "data": {
    "clock": "25:00",
    "progress": 0,
    "button": "暂停",
    "note": "",
    "source": "Python 模拟业务；并非真实外心状态"
  }
}
