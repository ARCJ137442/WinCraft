{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wincraft:protocol:0.4-preview.1:scope-request",
  "title": "WinCraft component scope and typed state slot preview requests",
  "description": "Request shape validation only; schema/value compatibility, ownership and compare-and-set revision checks are enforced atomically by the host.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.partition"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/WorldLease"},
            "expected_revision": {"type": "integer", "minimum": 0},
            "scopes": {
              "type": "array",
              "minItems": 2,
              "maxItems": 32,
              "items": {"$ref": "#/$defs/ScopeDefinition"}
            }
          },
          "required": ["world_id", "lease", "expected_revision", "scopes"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.join"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "scope_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1},
            "join_key": {"type": "string", "minLength": 32, "maxLength": 80},
            "mode": {"enum": ["read", "write"]}
          },
          "required": ["world_id", "scope_id", "generation", "join_key", "mode"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.snapshot"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "scope_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1}
          },
          "required": ["world_id", "scope_id", "generation"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.status"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "scope_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1}
          },
          "required": ["world_id", "scope_id", "generation"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.patch"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "expected_scope_revision": {"type": "integer", "minimum": 0},
            "ops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"$ref": "#/$defs/ScopeOperation"}
            }
          },
          "required": ["world_id", "lease", "expected_scope_revision", "ops"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.action.result"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "event_id": {"type": "string", "format": "uuid"},
            "ok": {"type": "boolean"},
            "message": {"type": ["string", "null"], "maxLength": 512}
          },
          "required": ["world_id", "lease", "event_id", "ok"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.structure.patch"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "authority_lease": {"$ref": "#/$defs/WorldLease"},
            "expected_revision": {"type": "integer", "minimum": 0},
            "ops": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"$ref": "#/$defs/ScopeOperation"}
            }
          },
          "required": ["world_id", "authority_lease", "expected_revision", "ops"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.data.replace"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "expected_scope_revision": {"type": "integer", "minimum": 0},
            "data": {}
          },
          "required": ["world_id", "lease", "expected_scope_revision", "data"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.renew"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"}
          },
          "required": ["world_id", "lease"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "scope.leave"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "scope_id": {"type": "string", "format": "uuid"}
          },
          "required": ["world_id", "scope_id"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "state.slot.create"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "name": {"$ref": "#/$defs/StateSlotName"},
            "schema": {"$ref": "#/$defs/StateSlotSchema"},
            "initial_value": {"$ref": "#/$defs/StateSlotValue"},
            "reader_scopes": {
              "type": "array",
              "maxItems": 31,
              "items": {"$ref": "#/$defs/StateSlotScopeRef"}
            }
          },
          "required": ["world_id", "lease", "name", "schema", "initial_value"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "state.slot.set_readers"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "slot_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1},
            "expected_revision": {"type": "integer", "minimum": 1},
            "reader_scopes": {
              "type": "array",
              "maxItems": 31,
              "items": {"$ref": "#/$defs/StateSlotScopeRef"}
            }
          },
          "required": ["world_id", "lease", "slot_id", "generation", "expected_revision", "reader_scopes"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "state.slot.read"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "slot_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1},
            "reader_scope_id": {"type": "string", "format": "uuid"},
            "reader_scope_generation": {"type": "integer", "minimum": 1}
          },
          "required": ["world_id", "slot_id", "generation", "reader_scope_id", "reader_scope_generation"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "state.slot.compare_and_set"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "slot_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1},
            "expected_revision": {"type": "integer", "minimum": 1},
            "value": {"$ref": "#/$defs/StateSlotValue"}
          },
          "required": ["world_id", "lease", "slot_id", "generation", "expected_revision", "value"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "method": {"const": "state.slot.delete"},
        "params": {
          "type": "object",
          "properties": {
            "world_id": {"type": "string", "format": "uuid"},
            "lease": {"$ref": "#/$defs/ScopedLease"},
            "slot_id": {"type": "string", "format": "uuid"},
            "generation": {"type": "integer", "minimum": 1},
            "expected_revision": {"type": "integer", "minimum": 1}
          },
          "required": ["world_id", "lease", "slot_id", "generation", "expected_revision"],
          "additionalProperties": false
        }
      },
      "required": ["id", "method", "params"],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "WorldLease": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "epoch": {"type": "integer", "minimum": 0}
      },
      "required": ["id", "epoch"],
      "additionalProperties": false
    },
    "ScopedLease": {
      "type": "object",
      "properties": {
        "scope_id": {"type": "string", "format": "uuid"},
        "lease_id": {"type": "string", "format": "uuid"},
        "epoch": {"type": "integer", "minimum": 1},
        "generation": {"type": "integer", "minimum": 1}
      },
      "required": ["scope_id", "lease_id", "epoch", "generation"],
      "additionalProperties": false
    },
    "ScopeDefinition": {
      "type": "object",
      "properties": {
        "root_node_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "data_namespace": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$"}
      },
      "required": ["root_node_id", "data_namespace"],
      "additionalProperties": false
    },
    "StateSlotName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "StateSlotScopeRef": {
      "type": "object",
      "properties": {
        "scope_id": {"type": "string", "format": "uuid"},
        "generation": {"type": "integer", "minimum": 1}
      },
      "required": ["scope_id", "generation"],
      "additionalProperties": false
    },
    "StateSlotSchema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {"type": {"const": "boolean"}},
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "integer"},
            "min": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
            "max": {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "number"},
            "min": {"type": "number"},
            "max": {"type": "number"}
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "string"},
            "max_chars": {"type": "integer", "minimum": 1, "maximum": 8192}
          },
          "required": ["type", "max_chars"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {"const": "enum"},
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            }
          },
          "required": ["type", "values"],
          "additionalProperties": false
        }
      ]
    },
    "StateSlotValue": {
      "anyOf": [
        {"type": "boolean"},
        {"type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807},
        {"type": "number"},
        {"type": "string", "maxLength": 8192}
      ]
    },
    "ScopeOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {"const": "props"},
            "node_id": {"$ref": "#/$defs/NodeId"},
            "props": {"type": "object", "maxProperties": 32}
          },
          "required": ["op", "node_id", "props"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {"const": "insert"},
            "parent": {"$ref": "#/$defs/NodeId"},
            "index": {"type": "integer", "minimum": 0},
            "node": {"$ref": "#/$defs/Node"}
          },
          "required": ["op", "parent", "index", "node"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {"const": "remove"},
            "node_id": {"$ref": "#/$defs/NodeId"}
          },
          "required": ["op", "node_id"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {"const": "replace"},
            "node_id": {"$ref": "#/$defs/NodeId"},
            "node": {"$ref": "#/$defs/Node"}
          },
          "required": ["op", "node_id", "node"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {"const": "move"},
            "node_id": {"$ref": "#/$defs/NodeId"},
            "parent": {"$ref": "#/$defs/NodeId"},
            "index": {"type": "integer", "minimum": 0}
          },
          "required": ["op", "node_id", "parent", "index"],
          "additionalProperties": false
        }
      ]
    },
    "NodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/NodeId"},
        "kind": {"enum": ["stack", "row", "text", "metric", "progress", "badge", "button", "input", "textarea", "key_value", "icon", "bar_chart", "divider"]},
        "props": {"type": "object", "maxProperties": 32},
        "children": {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/Node"}
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    }
  }
}
