{
  "protocol": "0.4-preview.1",
  "base_protocol": "0.3",
  "status": "preview",
  "capability": {
    "name": "component_leases",
    "version": 1
  },
  "optional_capabilities": [
    { "name": "provider_inventory", "version": 1 },
    { "name": "scope_interactions", "version": 1 }
  ],
  "handshake_schema": "hello.schema.json",
  "request_schema": "scope-request.schema.json",
  "methods": [
    "provider.inventory.register",
    "provider.inventory.list",
    "scope.partition",
    "scope.join",
    "scope.snapshot",
    "scope.patch",
    "scope.action.result",
    "scope.structure.patch",
    "scope.data.replace",
    "scope.renew",
    "scope.leave",
    "state.slot.create",
    "state.slot.set_readers",
    "state.slot.read",
    "state.slot.compare_and_set",
    "state.slot.delete"
  ],
  "constraints": {
    "provider_inventory": {
      "status": "preview",
      "version": 1,
      "registration_schema": "../provider-inventory-registration.schema.json",
      "snapshot_schema": "../provider-inventory.schema.json",
      "registration_grants": "never_accepted",
      "discovery_grants_operations": false
    },
    "max_scopes_per_world": 32,
    "scope_roots_must_be_disjoint": true,
    "scope_data_namespace": "unique top-level scene.data key",
    "scope_patch_operations": ["props", "insert", "remove", "replace", "move"],
    "root_structure_patch": "scope.structure.patch",
    "parent_revocation": "generation_fence",
    "scope_snapshot_events": "filtered_per_reader",
    "state_slots": {
      "status": "preview",
      "version": 1,
      "schema_types": ["boolean", "integer", "number", "string", "enum"],
      "max_slots_per_world": 64,
      "max_slots_per_scope": 16,
      "max_readers_per_slot": 31,
      "value_bytes": 8192,
      "writes": "owner_scope_cas",
      "reads": "explicit_scope_grants"
    },
    "scope_interactions": {
      "status": "preview",
      "version": 1,
      "event": "scope.interaction",
      "event_schema": "scope-interaction-event.schema.json",
      "result_method": "scope.action.result",
      "routing": "component_scope_owner",
      "native_window_actions": false
    },
    "interactive_scope_components": true,
    "stable_0_3_world_writer_and_scope_writers_may_not_coexist": true
  }
}
