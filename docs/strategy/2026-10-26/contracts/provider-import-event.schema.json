{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wincraft:proposal:provider-import-event:draft-2026-10-26",
  "title": "User-confirmed provider import event",
  "description": "Preview contract only; not part of stable Protocol 0.3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event": {"const": "world.import.joined"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "wincraft.provider-import.event"},
        "schema_version": {"const": "draft-2026-10-26"},
        "host_id": {"type": "string", "format": "uuid"},
        "pack_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"},
        "pack_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "blueprint_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"},
        "blueprint_world_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"},
        "binding_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"}
        },
        "approved_permissions": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"}
        },
        "world": {
          "type": "object",
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "revision": {"type": "integer", "minimum": 1},
            "sequence": {"type": "integer", "minimum": 1},
            "window_revision": {"type": "integer", "minimum": 1},
            "epoch": {"type": "integer", "minimum": 1},
            "system": {"const": false},
            "writer": {"type": "string", "format": "uuid"},
            "status": {"const": "online"},
            "window": {"type": "object"},
            "scene": {"type": "object"},
            "native": {"type": "object"},
            "actions": {"type": "array"}
          },
          "required": ["id", "revision", "sequence", "window_revision", "epoch", "system", "writer", "status", "window", "scene", "native", "actions"]
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "format": "uuid"},
            "epoch": {"type": "integer", "minimum": 1}
          },
          "required": ["id", "epoch"]
        }
      },
      "required": ["kind", "schema_version", "host_id", "pack_id", "pack_version", "blueprint_id", "blueprint_world_id", "binding_ids", "approved_permissions", "world", "lease"]
    }
  },
  "required": ["event", "data"]
}
