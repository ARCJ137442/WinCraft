{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wincraft:proposal:pack:draft-2026-10-26",
  "title": "配置包提案",
  "description": "研发提案；不是现有0.3宿主接口。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "wincraft.pack.draft"
    },
    "schema_version": {
      "const": "draft-2026-10-26"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
          },
          "required": {
            "type": "boolean"
          },
          "provider_types": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "capabilities": {
            "type": "array",
            "contains": {"const": "world.import.accept"},
            "minContains": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
            },
            "uniqueItems": true,
            "maxItems": 64
          },
          "min_adapter_contract": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "id",
          "required",
          "provider_types",
          "capabilities",
          "permissions",
          "min_adapter_contract"
        ]
      }
    },
    "blueprint": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
    },
    "theme_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
    },
    "fallback_policy": {
      "enum": [
        "explain_missing",
        "hide_optional"
      ]
    },
    "adapter": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "external-program-reference"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,95}$"
            },
            "reference": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "execution": {
              "const": "separate-user-approval"
            }
          },
          "required": [
            "kind",
            "id",
            "reference",
            "sha256",
            "execution"
          ]
        }
      ]
    }
  },
  "required": [
    "kind",
    "schema_version",
    "id",
    "version",
    "title",
    "bindings",
    "blueprint",
    "fallback_policy",
    "adapter"
  ]
}
